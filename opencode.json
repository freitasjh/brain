{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./.opencode/plugins/harness-validator.js", "./.opencode/plugins/hitl-guardrail.js"],
  "instructions": [
    ".agents/rules/*.md"
  ],
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "system": "{file:./.agents/agents/orchestrator/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "developer-engineer": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/developer-engineer/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "codebase-analyzer": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/codebase-analyzer/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "product-manager": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/product-manager/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "qa-engineer": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/qa-engineer/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "architect": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/architect/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "security-engineer": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/security-engineer/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "code-reviewer": {
      "mode": "subagent",
      "system": "{file:./.agents/agents/code-reviewer/AGENT.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}

# Brain MCP Server — config via environment variables (prefix BRAIN_)
# Copy to .env and adjust:

BRAIN_VAULT_PATH=./vault
BRAIN_OLLAMA_URL=http://localhost:11434
BRAIN_OLLAMA_MODEL=nomic-embed-text
BRAIN_INDEX_PATH=./data/index.db
BRAIN_PORT=8321
BRAIN_TRANSPORT=sse
BRAIN_LOG_LEVEL=INFO
BRAIN_CHUNK_MAX_TOKENS=4096

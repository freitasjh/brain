# Brain — Rust SQLite-only (BRAIN_ prefix)
# Copy to .env and adjust. Ver AGENTS.md para a tabela completa.

# --- storage (única fonte de verdade) ---
BRAIN_DB_PATH=./data/brain.db

# --- embeddings ---
# Userinfo é suportado e REDIGIDO em erro e log: http://user:pass@host vira
# http://***@host. Não coloque senha real aqui se o arquivo for versionado.
BRAIN_OLLAMA_URL=http://localhost:11434
BRAIN_OLLAMA_MODEL=nomic-embed-text
BRAIN_EMBED_TIMEOUT_SECS=60
# teto de tentativas antes do dead-letter; 0/inválido = 8
BRAIN_EMBED_MAX_FAILURES=8

# --- transporte ---
BRAIN_PORT=8321
BRAIN_VIEWER_PORT=8322
BRAIN_LOG_LEVEL=INFO

# --- escrita em disco (allowlist) ---
# Único diretório onde `brain export` e `brain backup` podem escrever.
# Fora dele, ambos recusam.
BRAIN_EXPORT_ROOT=/tmp/brain-export

# --- reuso de embedding ---
# 1.0 = exato. Abaixo disso um chunk editado herda o vetor antigo.
# A guarda de força normativa bloqueia o reuso de DEVE->NAO DEVE de qualquer jeito.
BRAIN_REUSE_SIMILARITY=1.0

# --- hooks ---
# 0 pula o embed no hook; a captura do evento nunca depende dele.
BRAIN_HOOK_EMBED=1

# Removidos (constraint C01, SQLite-only): BRAIN_VAULT_PATH, BRAIN_INDEX_PATH
